[Unit]
Description=PageWright registered-site HTTP-01 certificate reconciliation
After=docker.service nginx.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/pagewright-tls.env
ExecStart=/usr/bin/python3 /usr/local/libexec/pagewright-pilot-tls.py --apply --production --email ${ACME_EMAIL}
TimeoutStartSec=600
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/pagewright-tls /etc/nginx/conf.d /var/log/nginx /run

[Install]
WantedBy=multi-user.target
