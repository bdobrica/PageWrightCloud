# PageWrightCloud Environment Configuration
# Copy this file to .env and fill in your values
# Root Compose: PAGEWRIGHT_*_PORT values change host-published ports only.
# Containers retain fixed service ports: PostgreSQL 5432, Redis 6379,
# gateway 8085, manager 8081, storage 8080, serving 8083, worker 8082.
# UI, themes, and nginx listen on container port 80.
# Keep internal service URLs on those container ports. When changing gateway's
# host port, update browser-facing VITE URLs and the OAuth redirect URL below.

# =============================================================================
# INFRASTRUCTURE
# =============================================================================

# PostgreSQL (Gateway Database)
# Root Compose fixes database/user to pagewright and uses PAGEWRIGHT_POSTGRES_PASSWORD.
# PostgreSQL and Redis ports are not published by root Compose.

# Redis (Manager Queue)
PAGEWRIGHT_REDIS_ADDR=redis:6379
# Required independent secret (16+ random bytes), not a provider/service token.
PAGEWRIGHT_REDIS_PASSWORD=
PAGEWRIGHT_REDIS_DB=0

# Single-host storage uses the existing nfs_data named volume at fixed /nfs.
# The backend's historical name is "nfs", but no NFS server/mount is required.
# PAGEWRIGHT_NFS_BASE_PATH applies when running storage directly; root Compose
# fixes it to /nfs so artifacts stay inside the persistent named volume.

# =============================================================================
# GATEWAY SERVICE (Port 8085)
# =============================================================================

PAGEWRIGHT_GATEWAY_PORT=8085
# Required: generate independent random values; no working production defaults.
# Root Compose wires this password into PostgreSQL and gateway together.
PAGEWRIGHT_POSTGRES_PASSWORD=
PAGEWRIGHT_JWT_SECRET=
# Independent internal control-plane secret (32+ random bytes); never a worker/API key.
PAGEWRIGHT_SERVICE_TOKEN=
# Direct-process deployments only: explicit PostgreSQL URL, password 16+ bytes,
# sslmode required. Root Compose ignores this variable in favor of discrete fields.
# PAGEWRIGHT_DATABASE_URL=
PAGEWRIGHT_JWT_EXPIRATION=15m
PAGEWRIGHT_DEFAULT_PAGE_SIZE=25

# Google OAuth (Required for OAuth login)
PAGEWRIGHT_GOOGLE_CLIENT_ID=
PAGEWRIGHT_GOOGLE_CLIENT_SECRET=
PAGEWRIGHT_GOOGLE_REDIRECT_URL=http://localhost:8085/auth/google/callback

# LLM Configuration (Required for chat-based builds)
PAGEWRIGHT_LLM_KEY=
PAGEWRIGHT_LLM_URL=https://api.openai.com/v1

# Pilot admission: default is operator-provisioned accounts, not public signup.
# Only disposable local tests should set SIGNUP_MODE=development.
PAGEWRIGHT_SIGNUP_MODE=closed
PAGEWRIGHT_USER_DAILY_BUILDS=10
PAGEWRIGHT_SITE_DAILY_BUILDS=5
PAGEWRIGHT_ACTIVE_BUILDS=2
# Lifetime conservative AI allowance in cents; 0 disables provider calls.
# Increasing this total grants only the increment; restarting never resets it.
PAGEWRIGHT_AI_ALLOWANCE_CENTS=0
# Separate random internal credential, at least 32 characters; NOT the API key.
PAGEWRIGHT_PROVIDER_TOKEN=

# Internal service URLs (container DNS names and fixed container ports)
PAGEWRIGHT_STORAGE_URL=http://storage:8080
PAGEWRIGHT_MANAGER_URL=http://manager:8081
PAGEWRIGHT_SERVING_URL=http://serving:8083

# =============================================================================
# MANAGER SERVICE (Port 8081)
# =============================================================================

# Direct-process listen port only; root Compose does not publish this API.
PAGEWRIGHT_MANAGER_PORT=8081
PAGEWRIGHT_QUEUE_BACKEND=redis
PAGEWRIGHT_WORKER_SPAWNER=docker
PAGEWRIGHT_LOCK_TTL=5m
PAGEWRIGHT_LOCK_RENEW_INTERVAL=1m
PAGEWRIGHT_WORKER_IMAGE=pagewright-worker:m4.5
# On AppArmor hosts, load security/pagewright-worker-proc.apparmor, then set
# this to pagewright-worker-proc; see docs/WORKER_ISOLATION.md.
PAGEWRIGHT_WORKER_APPARMOR_PROFILE=
# Root Compose now fixes worker provider access to the internal budget proxy and
# gpt-5.6-luna. Legacy WORKER_LLM_KEY/URL/MODEL values are no longer used there.
# Root Compose derives worker network from its project name and uses /work.
PAGEWRIGHT_WORKER_TIMEOUT=30m
# Root Compose derives dispatch concurrency from PAGEWRIGHT_ACTIVE_BUILDS.
PAGEWRIGHT_DISPATCH_CLAIM_TTL=30s

# =============================================================================
# STORAGE SERVICE (Port 8080)
# =============================================================================

# Direct-process listen port only; root Compose does not publish this API.
PAGEWRIGHT_STORAGE_PORT=8080
# Filesystem backend identifier; root Compose stores its files in nfs_data.
PAGEWRIGHT_STORAGE_BACKEND=nfs

# =============================================================================
# SERVING SERVICE (Port 8083)
# =============================================================================

# Direct-process listen port only; root Compose does not publish this API.
PAGEWRIGHT_SERVING_PORT=8083
PAGEWRIGHT_WWW_ROOT=/var/www
PAGEWRIGHT_NGINX_SITES_ENABLED=/etc/nginx/sites-enabled
PAGEWRIGHT_NGINX_RELOAD_COMMAND=nginx -s reload
# Soft serving-cache total; active/receipt-pinned and one-minute grace entries win.
# Eviction never removes canonical storage archives; see docs/adr/0021-architecture-decisions-atomic-activation.md.
PAGEWRIGHT_MAX_VERSIONS_PER_SITE=10
PAGEWRIGHT_MAINTENANCE_PAGE_PATH=/etc/pagewright/503.html

# Nginx Port
PAGEWRIGHT_NGINX_PORT=8084
# Browser-visible hosting endpoint (use https/443 behind a TLS proxy).
# Route DNS and, for HTTPS, certificates for both <site> and preview.<site>.
# Match the public port mapping above, or your external proxy's listener.
PAGEWRIGHT_SITE_DOMAIN=pagewright.dev
PAGEWRIGHT_APP_ORIGINS=http://localhost:3000
# Exact comma-separated browser origins; no wildcards, paths or generated hosts.
# Example for the owned domain: https://app.pagewright.io
# Leave all SMTP fields empty to disable email reset explicitly (503).
# Production requires a real verified sender and HTTPS application origin.
PAGEWRIGHT_SMTP_ADDRESS=
PAGEWRIGHT_SMTP_MODE=
PAGEWRIGHT_SMTP_USERNAME=
PAGEWRIGHT_SMTP_PASSWORD=
PAGEWRIGHT_SMTP_FROM=
PAGEWRIGHT_RESET_URL=
# Example: PAGEWRIGHT_SMTP_ADDRESS=smtp.example.com:587,
# PAGEWRIGHT_SMTP_MODE=starttls (or tls for 465),
# PAGEWRIGHT_RESET_URL=https://app.pagewright.io/reset-password. Never use generated hosts.
# Owned production namespace: pagewright.io (or a dedicated sites.pagewright.io).
# Do not change live DNS/redirects until M4.9; see docs/adr/0024-architecture-decisions-identifier-security.md.
PAGEWRIGHT_HOSTING_SCHEME=http
PAGEWRIGHT_HOSTING_PORT=8084

# =============================================================================
# UI SERVICE (Port 3000)
# =============================================================================

PAGEWRIGHT_UI_PORT=3000
VITE_PAGEWRIGHT_API_URL=http://localhost:8085

# =============================================================================
# THEMES SERVICE (Port 8086)
# =============================================================================

# Legacy/direct-process setting; root Compose does not publish the theme registry.
PAGEWRIGHT_THEMES_PORT=8086

# =============================================================================
# WORKER SERVICE (Port 8082) - Optional, spawned by manager
# =============================================================================

# Worker status HTTP is container-loopback only, never published.
PAGEWRIGHT_WORKER_PORT=8082
PAGEWRIGHT_WORK_DIR=/work
PAGEWRIGHT_CODEX_BINARY=/usr/local/bin/codex
PAGEWRIGHT_INSTRUCTIONS_PATH=/.codex/instructions.md
PAGEWRIGHT_JOB={}

# Worker ID and Job (Set by manager at runtime)
# PAGEWRIGHT_WORKER_ID=
# PAGEWRIGHT_JOB=
